# Unreal Engine build artifacts (match at any depth)
Binaries/
Intermediate/
DerivedDataCache/
Saved/
Build/

# The sample game's stock content — ~135 MB of the UE5 Third Person template, regenerable in a
# couple of minutes (see Templates/ModFrameworkSample/README.md). Deliberately ANCHORED with a
# leading slash so it matches only this one directory: the example mod's Blueprint content at
# Mods/ExampleMod/Content/ and any plugin Content/ folder are real deliverables and must stay
# tracked. Do not turn this into a bare "Content/".
/Templates/ModFrameworkSample/Content/

# Generated project files
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Packaged mods and generated SDK bundles (build outputs, not source)
/Dist/
*.mod

# Agent orchestration scripts used to author parts of this repository. They are a record of how the
# work was produced, not something a contributor needs to build, run or maintain — and they embed
# absolute local paths, so they would not work on another machine anyway. Developer tooling lives in
# Tools/ and IS committed.
/.dev/

# Created by Setup.ps1 — junctions into the sibling plugin folders, never committed
/Templates/*/Plugins/

# OS cruft
Thumbs.db
desktop.ini
.DS_Store
/docs/internal
