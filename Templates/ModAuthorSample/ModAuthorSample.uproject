{
	"FileVersion": 3,
	"EngineAssociation": "5.8",
	"Category": "Modding",
	"Description": "Mod author's project. Contains ONLY the Game Mod SDK and the framework it depends on - no game source, no game content. If a mod builds and packages here, the SDK boundary is real.",
	"Modules": [
		{
			"Name": "ModAuthorSample",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"_comment": "ONE plugin. GameModSDK.uplugin declares ModFramework as a dependency, so UE enables it automatically - a mod author never installs, chooses, or thinks about the framework. If this list ever needs ModFramework spelled out, the SDK's descriptor is wrong.",
			"Name": "GameModSDK",
			"Enabled": true
		},
		{
			"Name": "ModelContextProtocol",
			"Enabled": true
		}
	]
}
